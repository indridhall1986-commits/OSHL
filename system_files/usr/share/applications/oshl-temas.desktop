[Desktop Entry]
Type=Application
Name=Temas OSHL
Comment=Trocar o visual do OSHL (painel, cores, terminal e papel de parede)
Exec=oshl-temas
Icon=oshl-temas
Categories=Settings;DesktopSettings;
Terminal=false
Actions=tron;matrix;reator;alerta;ambar;neon;

